{
    "name": "web-vulnerability-scanner-backend",
    "version": "1.0.0",
    "description": "Backend API for Web Application Vulnerability Scanner",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --detectOpenHandles --forceExit",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest --testPathPattern=tests/unit",
        "test:integration": "jest --testPathPattern=tests/integration",
        "test:scanner": "jest --testPathPattern=tests/unit/vulnerabilityScanner.test.js",
        "test:dorks": "jest --testPathPattern=tests/integration/dorkRoutes.test.js",
        "test:security": "jest --testPathPattern=tests/unit/securityPatterns.test.js"
    },
    "dependencies": {
        "@langchain/openai": "^1.2.12",
        "axios": "^1.6.0",
        "bcryptjs": "^3.0.3",
        "cheerio": "^1.0.0-rc.12",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "groq-sdk": "^0.37.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "langchain": "^1.2.29",
        "mysql2": "^3.6.3",
        "node-cron": "^3.0.3",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.3"
    },
    "jest": {
        "testEnvironment": "node",
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "**/*.js",
            "!node_modules/**",
            "!coverage/**"
        ],
        "testMatch": [
            "**/tests/**/*.test.js",
            "**/__tests__/**/*.js"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/node_modules/"
        ]
    }
}
