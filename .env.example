# ===========================================
# VulnScan Pro - Security Configuration
# Version 2.0.0
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ===========================================
# CRITICAL: Authentication & Security
# ===========================================

# JWT Secret - MUST be set in production!
# Generate with: openssl rand -hex 32
# Minimum 32 characters required
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters

# Token expiration (default: 24h)
JWT_EXPIRES_IN=24h

# Bcrypt rounds for password hashing (default: 12, min: 10)
BCRYPT_ROUNDS=12

# ===========================================
# Server Configuration
# ===========================================

PORT=5000
NODE_ENV=development

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# Database Configuration
# ===========================================

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=vulnscan_pro

# ===========================================
# Enterprise Features
# ===========================================

# Session configuration
SESSION_TIMEOUT=30m
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# Rate limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# API Keys (for external services)
OPENAI_API_KEY=
GROQ_API_KEY=

# Email (for MFA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@vulnscanpro.com

# ===========================================
# Security Headers
# ===========================================

# Enable additional security features
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_RATE_LIMIT=true

# CSRF Protection
CSRF_SECRET=your-csrf-secret

# ===========================================
# Audit Logging
# ===========================================

# Log retention period (in days)
AUDIT_LOG_RETENTION=90

# Log sensitive actions
LOG_AUTH_EVENTS=true
LOG_DATA_ACCESS=true
LOG_ADMIN_ACTIONS=true

# ===========================================
# Cloud Security (optional)
# ===========================================

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP Configuration
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# Azure Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ===========================================
# Compliance Settings
# ===========================================

# NIST CSF
NIST_COMPLIANCE_ENABLED=true

# GDPR
GDPR_MODE=true
DATA_RETENTION_DAYS=30

# SOC2
SOC2_MODE=false

# ===========================================
# Logging
# ===========================================
# Options: error, warn, info, debug
LOG_LEVEL=info

# ===========================================
# Application Version
# ===========================================

APP_VERSION=2.0.0
